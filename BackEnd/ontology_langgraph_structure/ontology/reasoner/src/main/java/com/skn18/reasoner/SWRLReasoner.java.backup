package com.skn18.reasoner;

import org.swrlapi.core.SWRLAPIFactory;
import org.swrlapi.core.SWRLRuleEngine;
import org.swrlapi.exceptions.SWRLParseException;
import org.swrlapi.parser.SWRLParser;
import org.semanticweb.owlapi.apibinding.OWLManager;
import org.semanticweb.owlapi.formats.TurtleDocumentFormat;
import org.semanticweb.owlapi.model.*;

import java.io.ByteArrayOutputStream;
import java.io.IOException;
import java.net.URI;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpResponse;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.time.Instant;
import java.util.List;
import java.util.Set;

/**
 * Executes SWRL rules locally using SWRLAPI/Drools and publishes inferred triples to a Fuseki dataset.
 *
 * Usage:
 * mvn -q clean package
 * java -jar target/swr-reasoner.jar ontology.owl instances.ttl rules.swrl http://localhost:3030/history
 */
public final class SWRLReasoner {

    private SWRLReasoner() {
    }

    public static void main(String[] args) throws Exception {
        if (args.length < 4) {
            System.err.println("Usage: java -jar swrl-reasoner.jar <ontology.owl> <instances.ttl> <rules.swrl> <fuseki_base>");
            System.exit(1);
        }

        Path ontologyPath = Path.of(args[0]);
        Path instancesPath = Path.of(args[1]);
        Path rulesPath = Path.of(args[2]);
        String fusekiBase = args[3].replaceAll("/$", "");

        OWLOntology ontology = loadOntology(ontologyPath);
        mergeInstances(ontology, instancesPath);

        runSWRL(ontology, rulesPath);

        byte[] ttl = exportOntology(ontology);

        uploadToFuseki(ttl, fusekiBase);

        System.out.println("Reasoning finished and uploaded to " + fusekiBase);
    }

    private static OWLOntology loadOntology(Path path) throws OWLOntologyCreationException {
        OWLOntologyManager manager = OWLManager.createOWLOntologyManager();
        return manager.loadOntologyFromOntologyDocument(path.toFile());
    }

    private static void mergeInstances(OWLOntology ontology, Path instancesPath)
            throws OWLOntologyCreationException {
        if (!Files.exists(instancesPath)) {
            return;
        }
        OWLOntologyManager manager = ontology.getOWLOntologyManager();
        OWLOntology instances = manager.loadOntologyFromOntologyDocument(instancesPath.toFile());
        manager.addAxioms(ontology, instances.getAxioms());
    }

    private static void runSWRL(OWLOntology ontology, Path rulesPath) throws IOException, SWRLParseException, OWLOntologyManipulationException {
        OWLOntologyManager manager = ontology.getOWLOntologyManager();
        OWLDataFactory factory = manager.getOWLDataFactory();
        
        // Namespace for metadata
        String baseIRI = ontology.getOntologyID().getOntologyIRI().orElse(IRI.create("http://example.org/")).toString();
        IRI histNS = IRI.create(baseIRI);
        OWLAnnotationProperty sourceProp = factory.getOWLAnnotationProperty(IRI.create(histNS + "source"));
        OWLAnnotationProperty inferredByProp = factory.getOWLAnnotationProperty(IRI.create(histNS + "inferredBy"));
        OWLAnnotationProperty inferredAtProp = factory.getOWLAnnotationProperty(IRI.create(histNS + "inferredAt"));
        
        // Mark original data as "manual"
        markOriginalData(ontology, factory, sourceProp);
        
        // Run SWRL inference
        SWRLRuleEngine engine = SWRLAPIFactory.createSWRLRuleEngine(ontology);
        SWRLParser parser = SWRLAPIFactory.createSWRLParser(ontology);

        List<String> lines = Files.readAllLines(rulesPath, StandardCharsets.UTF_8);
        int ruleIndex = 0;
        for (String line : lines) {
            String trimmed = line.trim();
            if (trimmed.isEmpty() || trimmed.startsWith("#")) {
                continue;
            }
            parser.parseSWRLRule(trimmed);
            ruleIndex++;
        }

        // Execute inference
        engine.infer();
        
        // Get inferred axioms and mark them
        Set<OWLAxiom> inferredAxioms = engine.getInferredOWLAxioms();
        OWLLiteral manualLiteral = factory.getOWLLiteral("manual");
        OWLLiteral inferredLiteral = factory.getOWLLiteral("inferred");
        OWLLiteral timestamp = factory.getOWLLiteral(Instant.now().toString());
        
        for (OWLAxiom axiom : inferredAxioms) {
            // Add inferred axioms to ontology
            manager.addAxiom(ontology, axiom);
            
            // Mark as inferred with metadata
            if (axiom instanceof OWLObjectPropertyAssertionAxiom) {
                OWLObjectPropertyAssertionAxiom propAxiom = (OWLObjectPropertyAssertionAxiom) axiom;
                OWLIndividual subject = propAxiom.getSubject().asOWLNamedIndividual();
                
                // Add source: "inferred"
                OWLAnnotation annotation1 = factory.getOWLAnnotation(sourceProp, inferredLiteral);
                OWLAnnotationAssertionAxiom sourceAxiom = factory.getOWLAnnotationAssertionAxiom(
                    subject.getIRI(), annotation1);
                manager.addAxiom(ontology, sourceAxiom);
                
                // Add inferredBy: "rule_N"
                OWLLiteral ruleLiteral = factory.getOWLLiteral("swrl_rule_" + String.format("%03d", ruleIndex));
                OWLAnnotation annotation2 = factory.getOWLAnnotation(inferredByProp, ruleLiteral);
                OWLAnnotationAssertionAxiom ruleAxiom = factory.getOWLAnnotationAssertionAxiom(
                    subject.getIRI(), annotation2);
                manager.addAxiom(ontology, ruleAxiom);
                
                // Add inferredAt: timestamp
                OWLAnnotation annotation3 = factory.getOWLAnnotation(inferredAtProp, timestamp);
                OWLAnnotationAssertionAxiom timeAxiom = factory.getOWLAnnotationAssertionAxiom(
                    subject.getIRI(), annotation3);
                manager.addAxiom(ontology, timeAxiom);
            }
        }
        
        System.out.println("Inferred " + inferredAxioms.size() + " axioms and marked with metadata");
    }
    
    private static void markOriginalData(OWLOntology ontology, OWLDataFactory factory, OWLAnnotationProperty sourceProp) {
        OWLOntologyManager manager = ontology.getOWLOntologyManager();
        OWLLiteral manualLiteral = factory.getOWLLiteral("manual");
        
        // Mark all existing object property assertions as "manual"
        for (OWLObjectPropertyAssertionAxiom axiom : ontology.getAxioms(AxiomType.OBJECT_PROPERTY_ASSERTION)) {
            OWLIndividual subject = axiom.getSubject().asOWLNamedIndividual();
            OWLAnnotation annotation = factory.getOWLAnnotation(sourceProp, manualLiteral);
            OWLAnnotationAssertionAxiom sourceAxiom = factory.getOWLAnnotationAssertionAxiom(
                subject.getIRI(), annotation);
            manager.addAxiom(ontology, sourceAxiom);
        }
    }

    private static byte[] exportOntology(OWLOntology ontology) throws OWLOntologyStorageException, IOException {
        OWLOntologyManager manager = ontology.getOWLOntologyManager();
        ByteArrayOutputStream outputStream = new ByteArrayOutputStream();
        manager.saveOntology(ontology, new TurtleDocumentFormat(), outputStream);
        return outputStream.toByteArray();
    }

    private static void uploadToFuseki(byte[] ttl, String fusekiBase) throws IOException, InterruptedException {
        HttpClient client = HttpClient.newHttpClient();
        URI uri = URI.create(fusekiBase + "/data?default");
        HttpRequest request = HttpRequest.newBuilder(uri)
                .header("Content-Type", "text/turtle")
                .POST(HttpRequest.BodyPublishers.ofByteArray(ttl))
                .build();

        HttpResponse<String> response = client.send(request, HttpResponse.BodyHandlers.ofString());
        if (response.statusCode() >= 300) {
            throw new IOException("Fuseki upload failed: " + response.statusCode() + " - " + response.body());
        }
    }
}

