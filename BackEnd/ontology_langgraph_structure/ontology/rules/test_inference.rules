# Test Ontology Inference Rules (Jena Rules)
# 테스트 온톨로지 추론 규칙 - SWRL에서 Jena Rules로 변환

@prefix test: <http://www.semanticweb.org/ontologies/test-basic#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# ===================================
# 1. 간접 인과관계 체인 추론
# ===================================

# 규칙 1.1: 2단계 간접 인과관계
# A → B → C 이면 A indirectlyCausedBy C
[rule1_1:
    (?a rdf:type test:Node)
    (?b rdf:type test:Node)
    (?c rdf:type test:Node)
    (?a test:leadsTo ?b)
    (?b test:leadsTo ?c)
    ->
    (?c test:indirectlyCausedBy ?a)
]

# 규칙 1.2: 3단계 간접 인과관계
# A → B → C → D 이면 A indirectlyCausedBy D
[rule1_2:
    (?a rdf:type test:Node)
    (?b rdf:type test:Node)
    (?c rdf:type test:Node)
    (?d rdf:type test:Node)
    (?a test:leadsTo ?b)
    (?b test:leadsTo ?c)
    (?c test:leadsTo ?d)
    ->
    (?d test:indirectlyCausedBy ?a)
]


# ===================================
# 2. 수렴 관계 처리
# ===================================

# 규칙 2.1: convergesTo도 leadsTo로 간주
[rule2_1:
    (?a rdf:type test:Node)
    (?b rdf:type test:Node)
    (?a test:convergesTo ?b)
    ->
    (?a test:leadsTo ?b)
]

# 규칙 2.2: 여러 노드가 수렴하면 다중 원인
[rule2_2:
    (?a rdf:type test:Node)
    (?b rdf:type test:Node)
    (?c rdf:type test:Node)
    (?a test:convergesTo ?c)
    (?b test:convergesTo ?c)
    notEqual(?a, ?b)
    ->
    (?c test:causedBy ?a)
    (?c test:causedBy ?b)
]


# ===================================
# 3. 시간 순서 검증
# ===================================

# 규칙 3.1: leadsTo 관계면 시간적으로 이전이어야 함
[rule3_1:
    (?a rdf:type test:Node)
    (?b rdf:type test:Node)
    (?a test:leadsTo ?b)
    (?a test:year ?y1)
    (?b test:year ?y2)
    greaterThan(?y1, ?y2)
    ->
    (?a test:invalidTemporalOrder ?b)
]


# ===================================
# 4. 체인 길이 계산
# ===================================

# 규칙 4.1: 체인의 시작 노드 식별
[rule4_1:
    (?n rdf:type test:Node)
    (?n test:order 1)
    ->
    (?n rdf:type test:ChainStart)
]

# 규칙 4.2: 체인의 끝 노드 식별 (다음 노드가 없으면)
[rule4_2:
    (?n rdf:type test:Node)
    noValue(?n test:leadsTo)
    ->
    (?n rdf:type test:ChainEnd)
]


# ===================================
# 5. 시나리오별 분류
# ===================================

# 규칙 5.1: scenario1은 긴 체인
[rule5_1:
    (?n rdf:type test:Node)
    (?n test:chainId "scenario1")
    ->
    (?n rdf:type test:LongChain)
]

# 규칙 5.2: scenario2는 분기 구조
[rule5_2:
    (?n rdf:type test:Node)
    (?n test:chainId "scenario2")
    ->
    (?n rdf:type test:BranchingStructure)
]

# 규칙 5.3: scenario3은 수렴 구조
[rule5_3:
    (?n rdf:type test:Node)
    (?n test:chainId "scenario3")
    ->
    (?n rdf:type test:ConvergingStructure)
]

# 규칙 5.4: scenario4는 짧은 체인
[rule5_4:
    (?n rdf:type test:Node)
    (?n test:chainId "scenario4")
    ->
    (?n rdf:type test:ShortChain)
]

# 규칙 5.5: scenario5는 복합 구조
[rule5_5:
    (?n rdf:type test:Node)
    (?n test:chainId "scenario5")
    ->
    (?n rdf:type test:ComplexStructure)
]


# ===================================
# 6. 어린이용 필터링
# ===================================

# 규칙 6.1: children 대상은 간단한 설명 필요
[rule6_1:
    (?n rdf:type test:Node)
    (?n test:targetAudience "children")
    ->
    (?n test:requiresSimpleExplanation "true"^^xsd:boolean)
]


# ===================================
# 7. 크로스 시나리오 연결 감지
# ===================================

# 규칙 7.1a: 서로 다른 시나리오가 leadsTo로 연결
[rule7_1a:
    (?a rdf:type test:Node)
    (?b rdf:type test:Node)
    (?a test:chainId ?id1)
    (?b test:chainId ?id2)
    notEqual(?id1, ?id2)
    (?a test:leadsTo ?b)
    ->
    (?a test:crossScenarioConnection ?b)
]

# 규칙 7.1b: 서로 다른 시나리오가 convergesTo로 연결
[rule7_1b:
    (?a rdf:type test:Node)
    (?b rdf:type test:Node)
    (?a test:chainId ?id1)
    (?b test:chainId ?id2)
    notEqual(?id1, ?id2)
    (?a test:convergesTo ?b)
    ->
    (?a test:crossScenarioConnection ?b)
]
