        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>casualtyCount</rdfs:label>
        <rdfs:comment>사상자 수</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- usedTactic -->
    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#usedTactic">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Battle"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>usedTactic</rdfs:label>
        <rdfs:comment>사용된 전술</rdfs:comment>
    </owl:DatatypeProperty>


    <!-- ========== Relationship 데이터 속성 ========== -->

    <!-- relationshipType -->
    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#relationshipType">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Relationship"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>relationshipType</rdfs:label>
        <rdfs:comment>관계 유형 (동료/적대/스승-제자/친구 등)</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- hasDescription -->
    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#hasDescription">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Relationship"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>hasDescription</rdfs:label>
        <rdfs:comment>관계 설명</rdfs:comment>
    </owl:DatatypeProperty>


    <!-- ========== 추론 결과 데이터 속성 (Inference Result Data Properties) ========== -->

    <!-- 시간 추론 결과 -->
    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#hasLifespan">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>hasLifespan</rdfs:label>
        <rdfs:comment>[추론] 수명 (연)</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#hasDuration">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>hasDuration</rdfs:label>
        <rdfs:comment>[추론] 지속 기간 (연)</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#belongsToPeriod">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>belongsToPeriod</rdfs:label>
        <rdfs:comment>[추론] 역사적 시대 (예: imjin_war_period)</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#warType">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>warType</rdfs:label>
        <rdfs:comment>[추론] 전쟁 유형 (prolonged_war 등)</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#ageAt">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>ageAt</rdfs:label>
        <rdfs:comment>[추론] 특정 사건 발생 시 나이</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- 인과관계 추론 결과 -->
    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#hasStatus">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Nation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>hasStatus</rdfs:label>
        <rdfs:comment>[추론] 국가 상태 (weakened 등)</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#hasStrategicAdvantage">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>hasStrategicAdvantage</rdfs:label>
        <rdfs:comment>[추론] 전략적 우위 (high 등)</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#strategicImportance">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Place"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>strategicImportance</rdfs:label>
        <rdfs:comment>[추론] 전략적 중요도 (high 등)</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- 인물 추론 결과 -->
    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#causeOfDeath">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>causeOfDeath</rdfs:label>
        <rdfs:comment>[추론] 사망 원인 (killed_in_battle 등)</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#hasInfluence">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>hasInfluence</rdfs:label>
        <rdfs:comment>[추론] 영향력 (high 등)</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#hasResponsibility">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>hasResponsibility</rdfs:label>
        <rdfs:comment>[추론] 책임 (defeat_responsibility 등)</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#hasLoyalty">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>hasLoyalty</rdfs:label>
        <rdfs:comment>[추론] 충성도 (high 등)</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- 패턴 추론 결과 -->
    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#hasStrategyPattern">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>hasStrategyPattern</rdfs:label>
        <rdfs:comment>[추론] 전략 패턴 (defensive_warfare, mobile_warfare 등)</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#hasWinningStreak">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>hasWinningStreak</rdfs:label>
        <rdfs:comment>[추론] 연승 패턴 (three_consecutive_wins 등)</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#hasComebackPattern">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>hasComebackPattern</rdfs:label>
        <rdfs:comment>[추론] 역전 패턴 (comeback_victory 등)</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#hasContestedStatus">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Place"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>hasContestedStatus</rdfs:label>
        <rdfs:comment>[추론] 경합 지역 상태 (contested_territory)</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#hasCommandPattern">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>hasCommandPattern</rdfs:label>
        <rdfs:comment>[추론] 지휘 교체 패턴 (commander_rotation)</rdfs:comment>
    </owl:DatatypeProperty>


    <!-- ========== Policy 관련 속성 ========== -->

    <!-- initiatedBy -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#initiatedBy">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Policy"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:label>initiatedBy</rdfs:label>
        <rdfs:comment>정책이 인물에 의해 시작되다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- hasObjective -->
    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#hasObjective">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Policy"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>hasObjective</rdfs:label>
        <rdfs:comment>정책의 목표</rdfs:comment>
    </owl:DatatypeProperty>


    <!-- ========== Institution 관련 속성 ========== -->

    <!-- establishedBy -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#establishedBy">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Institution"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:label>establishedBy</rdfs:label>
        <rdfs:comment>제도가 인물에 의해 설립되다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- hasPurpose -->
    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#hasPurpose">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Institution"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>hasPurpose</rdfs:label>
        <rdfs:comment>제도의 목적</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- relatedToPolicy -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#relatedToPolicy">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Institution"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Policy"/>
        <rdfs:label>relatedToPolicy</rdfs:label>
        <rdfs:comment>제도가 정책과 관련되다</rdfs:comment>
    </owl:ObjectProperty>

</rdf:RDF>
