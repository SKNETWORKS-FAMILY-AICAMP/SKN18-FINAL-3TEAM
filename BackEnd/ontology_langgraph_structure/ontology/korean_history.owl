<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.example.org/korean-history#"
     xml:base="http://www.example.org/korean-history"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:hist="http://www.example.org/korean-history#">
    <owl:Ontology rdf:about="http://www.example.org/korean-history">
        <rdfs:label>Korean History Ontology</rdfs:label>
        <rdfs:comment>조선시대 역사 온톨로지 - 인물, 사건, 장소, 국가, 전투, 인간관계</rdfs:comment>
    </owl:Ontology>



    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes (클래스)
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <!-- Person (인물) -->
    <owl:Class rdf:about="http://www.example.org/korean-history#Person">
        <rdfs:label>Person</rdfs:label>
        <rdfs:comment>역사적 인물</rdfs:comment>
    </owl:Class>

    <!-- Event (사건) -->
    <owl:Class rdf:about="http://www.example.org/korean-history#Event">
        <rdfs:label>Event</rdfs:label>
        <rdfs:comment>역사적 사건</rdfs:comment>
    </owl:Class>

    <!-- Battle (전투) - Event의 하위 클래스 -->
    <owl:Class rdf:about="http://www.example.org/korean-history#Battle">
        <rdfs:subClassOf rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:label>Battle</rdfs:label>
        <rdfs:comment>전투/해전</rdfs:comment>
    </owl:Class>

    <!-- Place (장소) -->
    <owl:Class rdf:about="http://www.example.org/korean-history#Place">
        <rdfs:label>Place</rdfs:label>
        <rdfs:comment>지리적 장소</rdfs:comment>
    </owl:Class>

    <!-- Nation (국가) -->
    <owl:Class rdf:about="http://www.example.org/korean-history#Nation">
        <rdfs:label>Nation</rdfs:label>
        <rdfs:comment>국가</rdfs:comment>
    </owl:Class>

    <!-- Year (연도) -->
    <owl:Class rdf:about="http://www.example.org/korean-history#Year">
        <rdfs:label>Year</rdfs:label>
        <rdfs:comment>연도</rdfs:comment>
    </owl:Class>

    <!-- Relationship (인간관계) -->
    <owl:Class rdf:about="http://www.example.org/korean-history#Relationship">
        <rdfs:label>Relationship</rdfs:label>
        <rdfs:comment>인물 간 관계 (동료, 적대, 스승-제자 등)</rdfs:comment>
    </owl:Class>

    <!-- Policy (정책) - Event의 하위 클래스 -->
    <owl:Class rdf:about="http://www.example.org/korean-history#Policy">
        <rdfs:subClassOf rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:label>Policy</rdfs:label>
        <rdfs:comment>국가 정책 (훈민정음 창제, 쇄국정책 등)</rdfs:comment>
    </owl:Class>

    <!-- Institution (제도) -->
    <owl:Class rdf:about="http://www.example.org/korean-history#Institution">
        <rdfs:label>Institution</rdfs:label>
        <rdfs:comment>국가 제도 (집현전, 의금부 등)</rdfs:comment>
    </owl:Class>



    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties (객체 속성)
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <!-- ========== Person 관련 속성 ========== -->

    <!-- participatesIn -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#participatesIn">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:label>participatesIn</rdfs:label>
        <rdfs:comment>인물이 사건에 참여하다</rdfs:comment>
        <owl:inverseOf rdf:resource="http://www.example.org/korean-history#hasParticipant"/>
    </owl:ObjectProperty>

    <!-- commands -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#commands">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Battle"/>
        <rdfs:label>commands</rdfs:label>
        <rdfs:comment>인물이 전투를 지휘하다</rdfs:comment>
        <owl:inverseOf rdf:resource="http://www.example.org/korean-history#hasCommander"/>
    </owl:ObjectProperty>

    <!-- bornIn -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#bornIn">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Place"/>
        <rdfs:label>bornIn</rdfs:label>
        <rdfs:comment>인물이 장소에서 태어나다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- diedIn -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#diedIn">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Place"/>
        <rdfs:label>diedIn</rdfs:label>
        <rdfs:comment>인물이 장소에서 사망하다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- affiliatedWith -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#affiliatedWith">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Nation"/>
        <rdfs:label>affiliatedWith</rdfs:label>
        <rdfs:comment>인물이 국가에 소속되다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- hasRelationship -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#hasRelationship">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Relationship"/>
        <rdfs:label>hasRelationship</rdfs:label>
        <rdfs:comment>인물이 관계를 갖다</rdfs:comment>
    </owl:ObjectProperty>


    <!-- ========== Event 관련 속성 ========== -->

    <!-- hasParticipant -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#hasParticipant">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:label>hasParticipant</rdfs:label>
        <rdfs:comment>사건이 참여자를 갖다</rdfs:comment>
        <owl:inverseOf rdf:resource="http://www.example.org/korean-history#participatesIn"/>
    </owl:ObjectProperty>

    <!-- hasCommander -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#hasCommander">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Battle"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:label>hasCommander</rdfs:label>
        <rdfs:comment>전투가 지휘관을 갖다</rdfs:comment>
        <owl:inverseOf rdf:resource="http://www.example.org/korean-history#commands"/>
    </owl:ObjectProperty>

    <!-- occursAt -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#occursAt">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Place"/>
        <rdfs:label>occursAt</rdfs:label>
        <rdfs:comment>사건이 장소에서 발생하다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- leadsTo (인과관계) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#leadsTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:label>leadsTo</rdfs:label>
        <rdfs:comment>사건이 다른 사건으로 이어지다 (인과관계)</rdfs:comment>
    </owl:ObjectProperty>

    <!-- causedBy -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#causedBy">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:label>causedBy</rdfs:label>
        <rdfs:comment>사건이 다른 사건에 의해 발생하다</rdfs:comment>
        <owl:inverseOf rdf:resource="http://www.example.org/korean-history#leadsTo"/>
    </owl:ObjectProperty>

    <!-- partOf -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#partOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:label>partOf</rdfs:label>
        <rdfs:comment>사건이 상위 사건의 일부이다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- involves -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#involves">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Nation"/>
        <rdfs:label>involves</rdfs:label>
        <rdfs:comment>사건이 국가를 포함하다</rdfs:comment>
    </owl:ObjectProperty>


    <!-- ========== Battle 추가 속성 ========== -->

    <!-- hasVictor -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#hasVictor">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Battle"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Nation"/>
        <rdfs:label>hasVictor</rdfs:label>
        <rdfs:comment>전투의 승자</rdfs:comment>
    </owl:ObjectProperty>

    <!-- hasDefeated -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#hasDefeated">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Battle"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Nation"/>
        <rdfs:label>hasDefeated</rdfs:label>
        <rdfs:comment>전투의 패자</rdfs:comment>
    </owl:ObjectProperty>


    <!-- ========== Place 관련 속성 ========== -->

    <!-- locatedIn -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#locatedIn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Place"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Place"/>
        <rdfs:label>locatedIn</rdfs:label>
        <rdfs:comment>장소가 상위 지역에 위치하다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- controlledBy -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#controlledBy">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Place"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Nation"/>
        <rdfs:label>controlledBy</rdfs:label>
        <rdfs:comment>장소가 국가에 의해 통제되다</rdfs:comment>
    </owl:ObjectProperty>


    <!-- ========== Nation 관련 속성 ========== -->

    <!-- engagesIn -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#engagesIn">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Nation"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:label>engagesIn</rdfs:label>
        <rdfs:comment>국가가 사건에 참여하다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- hasLeader -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#hasLeader">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Nation"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:label>hasLeader</rdfs:label>
        <rdfs:comment>국가가 지도자를 갖다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- alliedWith -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#alliedWith">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Nation"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Nation"/>
        <rdfs:label>alliedWith</rdfs:label>
        <rdfs:comment>국가가 다른 국가와 동맹을 맺다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- atWarWith -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#atWarWith">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Nation"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Nation"/>
        <rdfs:label>atWarWith</rdfs:label>
        <rdfs:comment>국가가 다른 국가와 전쟁 중이다</rdfs:comment>
    </owl:ObjectProperty>


    <!-- ========== Relationship 관련 속성 ========== -->

    <!-- between -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#between">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Relationship"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:label>between</rdfs:label>
        <rdfs:comment>관계의 당사자</rdfs:comment>
    </owl:ObjectProperty>

    <!-- inContext -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#inContext">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Relationship"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:label>inContext</rdfs:label>
        <rdfs:comment>관계가 발생한 사건</rdfs:comment>
    </owl:ObjectProperty>


    <!-- ========== 추론 결과 속성 (Inference Results) ========== -->

    <!-- 시간 추론 (Temporal Inference) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#occursBefore">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:label>occursBefore</rdfs:label>
        <rdfs:comment>[추론] 사건이 다른 사건보다 먼저 발생하다</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#occursAfter">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:label>occursAfter</rdfs:label>
        <rdfs:comment>[추론] 사건이 다른 사건보다 나중에 발생하다</rdfs:comment>
        <owl:inverseOf rdf:resource="http://www.example.org/korean-history#occursBefore"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#simultaneousWith">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:label>simultaneousWith</rdfs:label>
        <rdfs:comment>[추론] 사건이 다른 사건과 동시에 발생하다</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#contemporaryWith">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:label>contemporaryWith</rdfs:label>
        <rdfs:comment>[추론] 인물이 다른 인물과 동시대를 살다</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#seniorTo">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:label>seniorTo</rdfs:label>
        <rdfs:comment>[추론] 인물이 다른 인물의 선배이다</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#juniorTo">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:label>juniorTo</rdfs:label>
        <rdfs:comment>[추론] 인물이 다른 인물의 후배이다</rdfs:comment>
        <owl:inverseOf rdf:resource="http://www.example.org/korean-history#seniorTo"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#differentGenerationFrom">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:label>differentGenerationFrom</rdfs:label>
        <rdfs:comment>[추론] 인물이 다른 세대에 속한다 (30년 이상 차이)</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#aliveDuring">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:label>aliveDuring</rdfs:label>
        <rdfs:comment>[추론] 인물이 사건 발생 시 생존해 있었다</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#followedBy">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:label>followedBy</rdfs:label>
        <rdfs:comment>[추론] 사건이 다음 해에 발생한 사건이 있다</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#precededBy">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:label>precededBy</rdfs:label>
        <rdfs:comment>[추론] 사건이 전년도에 발생한 사건이 있다</rdfs:comment>
        <owl:inverseOf rdf:resource="http://www.example.org/korean-history#followedBy"/>
    </owl:ObjectProperty>

    <!-- 인과관계 추론 (Causal Inference) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#indirectlyCausedBy">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:label>indirectlyCausedBy</rdfs:label>
        <rdfs:comment>[추론] 사건이 다른 사건에 의해 간접적으로 발생하다 (2-3단계 인과관계)</rdfs:comment>
    </owl:ObjectProperty>

    <!-- 인물 관계 추론 (Person Inference) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#hasRelationshipWith">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:label>hasRelationshipWith</rdfs:label>
        <rdfs:comment>[추론] 인물이 다른 인물과 동료 관계이다</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#hasEnemyRelationship">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:label>hasEnemyRelationship</rdfs:label>
        <rdfs:comment>[추론] 인물이 다른 인물과 적대 관계이다</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#hasLocalTies">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:range rdf:resource="http://www.example.org/korean-history#Place"/>
        <rdfs:label>hasLocalTies</rdfs:label>
        <rdfs:comment>[추론] 인물이 장소와 지역 연고가 있다</rdfs:comment>
    </owl:ObjectProperty>



    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data Properties (데이터 속성)
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <!-- ========== Person 데이터 속성 ========== -->

    <!-- hasAlias -->
    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#hasAlias">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>hasAlias</rdfs:label>
        <rdfs:comment>별칭 (충무공, 李舜臣 등)</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- hasBirthYear -->
    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#hasBirthYear">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>hasBirthYear</rdfs:label>
        <rdfs:comment>출생년도</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- hasDeathYear -->
    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#hasDeathYear">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>hasDeathYear</rdfs:label>
        <rdfs:comment>사망년도</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- hasRole -->
    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#hasRole">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>hasRole</rdfs:label>
        <rdfs:comment>역��</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- hasRank -->
    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#hasRank">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>hasRank</rdfs:label>
        <rdfs:comment>직위/관직</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- hasMotive -->
    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#hasMotive">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>hasMotive</rdfs:label>
        <rdfs:comment>동기 (비하인드 스토리용)</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- hasAchievement -->
    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#hasAchievement">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>hasAchievement</rdfs:label>
        <rdfs:comment>업적</rdfs:comment>
    </owl:DatatypeProperty>


    <!-- ========== Event 데이터 속성 ========== -->

    <!-- hasDate -->
    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#hasDate">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>hasDate</rdfs:label>
        <rdfs:comment>날짜 (예: 1597년 9월 16일)</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- hasYear -->
    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#hasYear">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>hasYear</rdfs:label>
        <rdfs:comment>연도</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- hasOutcome -->
    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#hasOutcome">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>hasOutcome</rdfs:label>
        <rdfs:comment>결과</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- hasPrecondition -->
    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#hasPrecondition">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>hasPrecondition</rdfs:label>
        <rdfs:comment>선행 조건 (What-if 추론용)</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- hasImpact -->
    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#hasImpact">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>hasImpact</rdfs:label>
        <rdfs:comment>영향/파급효과</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- hasContext -->
    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#hasContext">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>hasContext</rdfs:label>
        <rdfs:comment>시대적 맥락</rdfs:comment>
    </owl:DatatypeProperty>


    <!-- ========== Battle 데이터 속성 ========== -->

    <!-- casualtyCount -->
    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#casualtyCount">
