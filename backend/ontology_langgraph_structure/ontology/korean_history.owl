<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.example.org/korean-history#"
     xml:base="http://www.example.org/korean-history"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:hist="http://www.example.org/korean-history#">
    <owl:Ontology rdf:about="http://www.example.org/korean-history">
        <rdfs:label>Korean History Ontology</rdfs:label>
        <rdfs:comment>조선시대 역사 온톨로지 - 인물, 사건, 제도, 문헌, 장소, 국가 등</rdfs:comment>
        <owl:versionInfo>2.0.0</owl:versionInfo>
    </owl:Ontology>


    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes (클래스) - TTL 인스턴스 기반
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <!-- Person (인물) - 106,122개 인스턴스 -->
    <owl:Class rdf:about="http://www.example.org/korean-history#Person">
        <rdfs:label>Person</rdfs:label>
        <rdfs:comment>역사적 인물 (왕, 신하, 학자, 장군 등)</rdfs:comment>
    </owl:Class>

    <!-- Event (사건) - 63,947개 인스턴스 -->
    <owl:Class rdf:about="http://www.example.org/korean-history#Event">
        <rdfs:label>Event</rdfs:label>
        <rdfs:comment>역사적 사건 (환국, 사화, 전쟁 등)</rdfs:comment>
    </owl:Class>

    <!-- Institution (제도/기관) - 60,067개 인스턴스 -->
    <owl:Class rdf:about="http://www.example.org/korean-history#Institution">
        <rdfs:label>Institution</rdfs:label>
        <rdfs:comment>국가 제도 및 기관 (집현전, 의금부, 당파 등)</rdfs:comment>
    </owl:Class>

    <!-- Document (문헌) - 9,098개 인스턴스 -->
    <owl:Class rdf:about="http://www.example.org/korean-history#Document">
        <rdfs:label>Document</rdfs:label>
        <rdfs:comment>역사적 문헌 (실록, 의궤, 고서 등)</rdfs:comment>
    </owl:Class>

    <!-- Nation (국가) - 6,809개 인스턴스 -->
    <owl:Class rdf:about="http://www.example.org/korean-history#Nation">
        <rdfs:label>Nation</rdfs:label>
        <rdfs:comment>국가 (조선, 명, 청, 일본 등)</rdfs:comment>
    </owl:Class>

    <!-- Place (장소) - 1,769개 인스턴스 -->
    <owl:Class rdf:about="http://www.example.org/korean-history#Place">
        <rdfs:label>Place</rdfs:label>
        <rdfs:comment>지리적 장소 (궁궐, 지역, 전쟁터 등)</rdfs:comment>
    </owl:Class>

    <!-- Battle (전투) - 1,446개 인스턴스, Event의 하위 클래스 -->
    <owl:Class rdf:about="http://www.example.org/korean-history#Battle">
        <rdfs:subClassOf rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:label>Battle</rdfs:label>
        <rdfs:comment>전투/해전 (명량해전, 행주대첩 등)</rdfs:comment>
    </owl:Class>

    <!-- Policy (정책) - 1,028개 인스턴스, Event의 하위 클래스 -->
    <owl:Class rdf:about="http://www.example.org/korean-history#Policy">
        <rdfs:subClassOf rdf:resource="http://www.example.org/korean-history#Event"/>
        <rdfs:label>Policy</rdfs:label>
        <rdfs:comment>국가 정책 (대동법, 균역법, 공신 제도 등)</rdfs:comment>
    </owl:Class>

    <!-- Object (물품) - 8개 인스턴스 -->
    <owl:Class rdf:about="http://www.example.org/korean-history#Object">
        <rdfs:label>Object</rdfs:label>
        <rdfs:comment>역사적 물품 (형구, 의복, 무기 등)</rdfs:comment>
    </owl:Class>

    <!-- Role (역할) - 4개 인스턴스 -->
    <owl:Class rdf:about="http://www.example.org/korean-history#Role">
        <rdfs:label>Role</rdfs:label>
        <rdfs:comment>인물의 역할 (관직, 직책 등)</rdfs:comment>
    </owl:Class>

    <!-- SocialClass (사회계층) - 4개 인스턴스 -->
    <owl:Class rdf:about="http://www.example.org/korean-history#SocialClass">
        <rdfs:label>SocialClass</rdfs:label>
        <rdfs:comment>사회 계층 (양반, 중인, 상민, 천민 등)</rdfs:comment>
    </owl:Class>


    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties (객체 속성) - TTL에서 실제 사용되는 프로퍼티
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <!-- ========== 참여/관계 (가장 많이 사용됨) ========== -->

    <!-- participatesIn (12,751회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#participatesIn">
        <rdfs:label>participatesIn</rdfs:label>
        <rdfs:comment>인물이 사건에 참여하다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- affiliatedWith (11,791회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#affiliatedWith">
        <rdfs:label>affiliatedWith</rdfs:label>
        <rdfs:comment>인물/기관이 국가/당파에 소속되다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- servedUnder (1,047회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#servedUnder">
        <rdfs:label>servedUnder</rdfs:label>
        <rdfs:comment>인물이 다른 인물(군주) 아래에서 섬기다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- contemporaryWith (1,168회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#contemporaryWith">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:label>contemporaryWith</rdfs:label>
        <rdfs:comment>인물이 다른 인물과 동시대를 살다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- attendedBy (4회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#attendedBy">
        <rdfs:label>attendedBy</rdfs:label>
        <rdfs:comment>사건에 참석한 인물</rdfs:comment>
    </owl:ObjectProperty>

    <!-- involvesPerson (2회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#involvesPerson">
        <rdfs:label>involvesPerson</rdfs:label>
        <rdfs:comment>사건이 인물을 포함하다</rdfs:comment>
    </owl:ObjectProperty>


    <!-- ========== 학문/교육 관계 ========== -->

    <!-- authored (1,258회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#authored">
        <rdfs:label>authored</rdfs:label>
        <rdfs:comment>인물이 문헌을 저술하다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- studentOf (921회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#studentOf">
        <rdfs:label>studentOf</rdfs:label>
        <rdfs:comment>인물이 다른 인물의 제자이다</rdfs:comment>
        <owl:inverseOf rdf:resource="http://www.example.org/korean-history#teacherOf"/>
    </owl:ObjectProperty>

    <!-- teacherOf (203회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#teacherOf">
        <rdfs:label>teacherOf</rdfs:label>
        <rdfs:comment>인물이 다른 인물의 스승이다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- compiled (613회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#compiled">
        <rdfs:label>compiled</rdfs:label>
        <rdfs:comment>인물이 문헌을 편찬하다</rdfs:comment>
    </owl:ObjectProperty>


    <!-- ========== 인과관계 ========== -->

    <!-- leadsTo (928회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#leadsTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label>leadsTo</rdfs:label>
        <rdfs:comment>사건이 다른 사건으로 이어지다 (인과관계)</rdfs:comment>
    </owl:ObjectProperty>

    <!-- ledTo (5회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#ledTo">
        <rdfs:label>ledTo</rdfs:label>
        <rdfs:comment>사건이 다른 사건으로 이어지다 (과거형)</rdfs:comment>
    </owl:ObjectProperty>

    <!-- causes (77회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#causes">
        <rdfs:label>causes</rdfs:label>
        <rdfs:comment>원인이 되다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- derivedFrom (3회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#derivedFrom">
        <rdfs:label>derivedFrom</rdfs:label>
        <rdfs:comment>~에서 유래하다</rdfs:comment>
    </owl:ObjectProperty>


    <!-- ========== 설립/제도 관련 ========== -->

    <!-- establishedBy (326회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#establishedBy">
        <rdfs:label>establishedBy</rdfs:label>
        <rdfs:comment>제도/기관이 인물에 의해 설립되다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- founded (138회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#founded">
        <rdfs:label>founded</rdfs:label>
        <rdfs:comment>인물이 기관을 설립하다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- reformed (141회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#reformed">
        <rdfs:label>reformed</rdfs:label>
        <rdfs:comment>인물이 제도를 개혁하다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- initiatedBy (175회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#initiatedBy">
        <rdfs:label>initiatedBy</rdfs:label>
        <rdfs:comment>정책이 인물에 의해 시작되다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- registeredThrough (2회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#registeredThrough">
        <rdfs:label>registeredThrough</rdfs:label>
        <rdfs:comment>~을 통해 등록되다</rdfs:comment>
    </owl:ObjectProperty>


    <!-- ========== 전투/지휘 관련 ========== -->

    <!-- commands (239회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#commands">
        <rdfs:label>commands</rdfs:label>
        <rdfs:comment>인물이 전투를 지휘하다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- supervises (4회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#supervises">
        <rdfs:label>supervises</rdfs:label>
        <rdfs:comment>감독하다</rdfs:comment>
    </owl:ObjectProperty>


    <!-- ========== 장소/위치 관련 ========== -->

    <!-- hasLocation (293회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#hasLocation">
        <rdfs:label>hasLocation</rdfs:label>
        <rdfs:comment>위치를 갖다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- storedAt (2회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#storedAt">
        <rdfs:label>storedAt</rdfs:label>
        <rdfs:comment>~에 보관되다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- originatedIn (2회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#originatedIn">
        <rdfs:label>originatedIn</rdfs:label>
        <rdfs:comment>~에서 유래하다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- heldAt (2회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#heldAt">
        <rdfs:label>heldAt</rdfs:label>
        <rdfs:comment>~에서 개최되다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- occursAt (2회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#occursAt">
        <rdfs:label>occursAt</rdfs:label>
        <rdfs:comment>사건이 장소에서 발생하다</rdfs:comment>
    </owl:ObjectProperty>


    <!-- ========== 부분/포함 관계 ========== -->

    <!-- partOf (239회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#partOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:label>partOf</rdfs:label>
        <rdfs:comment>~의 일부이다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- hasPart (3회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#hasPart">
        <rdfs:label>hasPart</rdfs:label>
        <rdfs:comment>부분을 갖다</rdfs:comment>
        <owl:inverseOf rdf:resource="http://www.example.org/korean-history#partOf"/>
    </owl:ObjectProperty>

    <!-- contains (동적) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#contains">
        <rdfs:label>contains</rdfs:label>
        <rdfs:comment>포함하다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- includesPositions (6회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#includesPositions">
        <rdfs:label>includesPositions</rdfs:label>
        <rdfs:comment>직위를 포함하다</rdfs:comment>
    </owl:ObjectProperty>


    <!-- ========== 문서/기록 관련 ========== -->

    <!-- documents (6회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#documents">
        <rdfs:label>documents</rdfs:label>
        <rdfs:comment>기록하다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- documentsEvent (4회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#documentsEvent">
        <rdfs:label>documentsEvent</rdfs:label>
        <rdfs:comment>사건을 기록하다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- records (2회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#records">
        <rdfs:label>records</rdfs:label>
        <rdfs:comment>기록하다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- lists (2회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#lists">
        <rdfs:label>lists</rdfs:label>
        <rdfs:comment>목록에 포함하다</rdfs:comment>
    </owl:ObjectProperty>


    <!-- ========== 재위/통치 관련 ========== -->

    <!-- reignedDuring (3회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#reignedDuring">
        <rdfs:label>reignedDuring</rdfs:label>
        <rdfs:comment>~의 재위 기간에 있었다</rdfs:comment>
    </owl:ObjectProperty>


    <!-- ========== 연결관계/기타 ========== -->

    <!-- originatedFrom (3회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#originatedFrom">
        <rdfs:label>originatedFrom</rdfs:label>
        <rdfs:comment>~에서 유래하다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- pairedWith (2회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#pairedWith">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:label>pairedWith</rdfs:label>
        <rdfs:comment>~과 짝을 이루다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- usedBy (2회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#usedBy">
        <rdfs:label>usedBy</rdfs:label>
        <rdfs:comment>~에 의해 사용되다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- usedIn (14회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#usedIn">
        <rdfs:label>usedIn</rdfs:label>
        <rdfs:comment>~에서 사용되다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- wasMostlyAffiliatedWith (동적) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#wasMostlyAffiliatedWith">
        <rdfs:label>wasMostlyAffiliatedWith</rdfs:label>
        <rdfs:comment>주로 ~에 소속되었다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- restoredPowerTo (동적) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#restoredPowerTo">
        <rdfs:label>restoredPowerTo</rdfs:label>
        <rdfs:comment>~에게 권력을 회복시키다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- investigatedBy (2회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#investigatedBy">
        <rdfs:label>investigatedBy</rdfs:label>
        <rdfs:comment>~에 의해 조사되다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- commonInstitutions (15회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#commonInstitutions">
        <rdfs:label>commonInstitutions</rdfs:label>
        <rdfs:comment>공통 기관</rdfs:comment>
    </owl:ObjectProperty>

    <!-- subjects (6회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#subjects">
        <rdfs:label>subjects</rdfs:label>
        <rdfs:comment>주제/대상</rdfs:comment>
    </owl:ObjectProperty>

    <!-- containsTopic (5회) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#containsTopic">
        <rdfs:label>containsTopic</rdfs:label>
        <rdfs:comment>주제를 포함하다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- designatesWornPrisonerAs (동적) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#designatesWornPrisonerAs">
        <rdfs:label>designatesWornPrisonerAs</rdfs:label>
        <rdfs:comment>착용한 죄수를 ~로 지칭하다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- prohibitedFor (동적) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#prohibitedFor">
        <rdfs:label>prohibitedFor</rdfs:label>
        <rdfs:comment>~에 대해 금지되다</rdfs:comment>
    </owl:ObjectProperty>

    <!-- isStoredAt (동적) -->
    <owl:ObjectProperty rdf:about="http://www.example.org/korean-history#isStoredAt">
        <rdfs:label>isStoredAt</rdfs:label>
        <rdfs:comment>~에 보관되다</rdfs:comment>
    </owl:ObjectProperty>


    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data Properties (데이터 속성) - TTL에서 실제 사용되는 프로퍼티
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <!-- ========== 연도/날짜 관련 (가장 많이 사용됨) ========== -->

    <!-- hasYear (16,903회) -->
    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#hasYear">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>hasYear</rdfs:label>
        <rdfs:comment>연도</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- hasBirthYear (451회) -->
    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#hasBirthYear">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>hasBirthYear</rdfs:label>
        <rdfs:comment>출생년도</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- hasDeathYear (1,048회) -->
    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#hasDeathYear">
        <rdfs:domain rdf:resource="http://www.example.org/korean-history#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>hasDeathYear</rdfs:label>
        <rdfs:comment>사망년도</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- hasStartYear (622회) -->
    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#hasStartYear">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>hasStartYear</rdfs:label>
        <rdfs:comment>시작년도</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- hasEndYear (521회) -->
    <owl:DatatypeProperty rdf:about="http://www.example.org/korean-history#hasEndYear">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>hasEndYear</rdfs:label>
        <rdfs:comment>종료년도</rdfs:comment>
    </owl:DatatypeProperty>

    <!-- hasReignStart (동적) -->
