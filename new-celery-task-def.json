        {
          "name": "GEMINI_API_KEY",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:533124807326:parameter/skn18-3-dev/GEMINI_API_KEY"
        },
        {
          "name": "FAL_KEY",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:533124807326:parameter/skn18-3-dev/FAL_KEY"
        }
      ],
      "dnsServers": [],
      "dnsSearchDomains": [],
