{
  "family": "skn18-3-dev-celery",
  "taskRoleArn": "arn:aws:iam::533124807326:role/skn18-3-ecs-TaskRole-izKhBr5E3GeH",
  "executionRoleArn": "arn:aws:iam::533124807326:role/skn18-3-ecs-TaskExecutionRole-iNerUbU1La7U",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "celery",
      "image": "533124807326.dkr.ecr.ap-northeast-2.amazonaws.com/skn18-3-dev-web:latest",
      "cpu": 0,
      "memory": 8192,
      "links": [],
      "portMappings": [],
      "essential": true,
      "entryPoint": [],
