      "environment": [
        {
          "name": "POSTGRES_USER",
          "value": "root"
        },
        {
          "name": "CELERY_BROKER_URL",
          "value": "redis://redis.skn18.local:6379/0"
        },
        {
          "name": "POSTGRES_HOST",
          "value": "postgres.skn18.local"
        },
        {
