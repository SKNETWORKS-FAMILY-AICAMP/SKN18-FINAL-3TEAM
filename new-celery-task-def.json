        {
          "name": "DJANGO_SECRET_KEY",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:533124807326:parameter/skn18-3-dev/DJANGO_SECRET_KEY"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:533124807326:parameter/skn18-3-dev/POSTGRES_PASSWORD"
        },
        {
          "name": "OPENAI_API_KEY",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:533124807326:parameter/skn18-3-dev/OPENAI_API_KEY"
        },
        {
          "name": "HF_API_TOKEN",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:533124807326:parameter/skn18-3-dev/HF_API_TOKEN"
        },
        {
          "name": "LANGCHAIN_API_KEY",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:533124807326:parameter/skn18-3-dev/LANGCHAIN_API_KEY"
